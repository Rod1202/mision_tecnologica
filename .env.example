# Copiar este archivo como .env.local y completar los valores.
# Nunca subir .env.local al repositorio.

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mostrar contenido pendiente de validación (clientes, modelos HP, hito 2026).
# En desarrollo se muestra siempre. En la prueba de Netlify y en producción
# solo se muestra si esta variable es "true". En producción debe quedar en "false".
SHOW_UNVERIFIED_CONTENT=true

# --- Siguiente fase: Payload CMS + Supabase (aún no se usan) ---
# Cadena de conexión PostgreSQL de Supabase (Project Settings > Database > Connection string)
# DATABASE_URI=postgresql://postgres.bbnkqkjznrpcaddesvtq:<PASSWORD>@<HOST>:5432/postgres
# PAYLOAD_SECRET=<cadena-aleatoria-larga>
